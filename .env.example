# 也可以直接在平台的“模型配置”页面填写，页面会写入本地 .env（不会提交到仓库）。
PLATFORM_DATABASE_URL=sqlite+aiosqlite:///:memory:
PLATFORM_LOG_LEVEL=INFO

# 在本地 .env 的等号后填写密钥，不要写入此示例或发到聊天里。
DEEPSEEK_API_KEY=
PLATFORM_LLM_BASE_URL=https://api.deepseek.com
PLATFORM_LLM_MODEL=deepseek-flash
PLATFORM_LLM_MAX_TOKENS=1024
PLATFORM_LLM_TIMEOUT_SECONDS=60
